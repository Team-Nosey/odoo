<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_station_tree" model="ir.ui.view">
        <field name="name">marathon.station.tree</field>
        <field name="model">marathon.station</field>
        <field name="arch" type="xml">
            <list string="Stations">
                <field name="name"/>
                <field name="call_letters"/>
                <field name="network_id"/>
                <field name="market"/>
                <field name="timezone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_marathon_station_form" model="ir.ui.view">
        <field name="name">marathon.station.form</field>
        <field name="model">marathon.station</field>
        <field name="arch" type="xml">
            <form string="Station">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Station Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="call_letters"/>
                            <field name="network_id"/>
                            <field name="market"/>
                        </group>
                        <group>
                            <field name="timezone"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Operational notes about this station..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_marathon_station_search" model="ir.ui.view">
        <field name="name">marathon.station.search</field>
        <field name="model">marathon.station</field>
        <field name="arch" type="xml">
            <search string="Stations">
                <field name="name"/>
                <field name="call_letters"/>
                <field name="network_id"/>
                <field name="market"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Network" name="group_network" context="{'group_by': 'network_id'}"/>
                <filter string="Market" name="group_market" context="{'group_by': 'market'}"/>
                <filter string="Timezone" name="group_tz" context="{'group_by': 'timezone'}"/>
            </search>
        </field>
    </record>

    <record id="action_marathon_station" model="ir.actions.act_window">
        <field name="name">Stations</field>
        <field name="res_model">marathon.station</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_marathon_station_search"/>
    </record>

</odoo>
