<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_sales_plan_tree" model="ir.ui.view">
        <field name="name">marathon.sales.plan.tree</field>
        <field name="model">marathon.sales.plan</field>
        <field name="arch" type="xml">
            <list string="Sales Plans">
                <field name="name"/>
                <field name="advertiser_id"/>
                <field name="brand_id"/>
                <field name="program_id"/>
                <field name="quarter"/>
                <field name="year"/>
                <field name="total_budget"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_marathon_sales_plan_form" model="ir.ui.view">
        <field name="name">marathon.sales.plan.form</field>
        <field name="model">marathon.sales.plan</field>
        <field name="arch" type="xml">
            <form string="Sales Plan">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Plan Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="advertiser_id"/>
                            <field name="brand_id"/>
                            <field name="program_id"/>
                        </group>
                        <group>
                            <field name="quarter"/>
                            <field name="year"/>
                            <field name="total_budget"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marathon_sales_plan" model="ir.actions.act_window">
        <field name="name">Sales Plans</field>
        <field name="res_model">marathon.sales.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
