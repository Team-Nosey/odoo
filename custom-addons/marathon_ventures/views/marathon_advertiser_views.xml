<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_advertiser_tree" model="ir.ui.view">
        <field name="name">marathon.advertiser.tree</field>
        <field name="model">marathon.advertiser</field>
        <field name="arch" type="xml">
            <list string="Advertisers">
                <field name="advertiser_number"/>
                <field name="name"/>
                <field name="account_id"/>
                <field name="advertiser_credit_limit"/>
                <field name="duplicate_approval"/>
                <field name="hold_placed_on_advertiser_account"/>
                <field name="advertiser_approved_to_book"/>
                <field name="brand_count" string="# Brands"/>
                <field name="deal_count" string="# Deals"/>
            </list>
        </field>
    </record>

    <record id="view_marathon_advertiser_form" model="ir.ui.view">
        <field name="name">marathon.advertiser.form</field>
        <field name="model">marathon.advertiser</field>
        <field name="arch" type="xml">
            <form string="Advertiser">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Advertiser Name"/></h1>
                        <h3><field name="advertiser_number" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Accounts">
                            <field name="account_id"/>
                            <field name="umbrella_account_id"/>
                            <field name="umbrella_account_2_id"/>
                        </group>
                        <group string="Credit / Status">
                            <field name="currency_id"/>
                            <field name="advertiser_credit_limit"/>
                            <field name="intacct_adv_balance"/>
                            <field name="advertiser_approved_to_book"/>
                            <field name="advertiser_cia"/>
                            <field name="hold_placed_on_advertiser_account"/>
                            <field name="monitoring"/>
                            <field name="new_advertiser"/>
                        </group>
                    </group>
                    <group>
                        <group string="Approval">
                            <field name="duplicate_approval"/>
                            <field name="duplicate_name_check"/>
                            <field name="commercial"/>
                        </group>
                        <group string="Dates">
                            <field name="adv_log_with_expiration_date"/>
                            <field name="log_exp_test"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Network Separation Rules" name="separation">
                            <group>
                                <group>
                                    <field name="accuweather_adv_sep"/>
                                    <field name="bouncetv_adv_sep"/>
                                    <field name="courttv_adv_sep"/>
                                    <field name="defy_adv_sep"/>
                                    <field name="grittv_adv_sep"/>
                                    <field name="ion_mys_adv_sep"/>
                                    <field name="ion_tv_adv_sep"/>
                                    <field name="laff_adv_sep"/>
                                </group>
                                <group>
                                    <field name="mlb_adv_sep"/>
                                    <field name="merit_street_adv_sep"/>
                                    <field name="nhl_adv_sep"/>
                                    <field name="nosey_adv_sep"/>
                                    <field name="quest_adv_sep"/>
                                    <field name="scripps_news_adv_sep"/>
                                    <field name="true_crime_adv_sep"/>
                                    <field name="twist_adv_sep"/>
                                </group>
                            </group>
                        </page>
                        <page string="Brands" name="brands">
                            <field name="brand_ids">
                                <list>
                                    <field name="brand_number"/>
                                    <field name="name"/>
                                    <field name="approval_status"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deals" name="deals">
                            <field name="deal_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="program_id"/>
                                    <field name="brand_id"/>
                                    <field name="status"/>
                                    <field name="sum_of_total_dollars"/>
                                </list>
                            </field>
                        </page>
                        <page string="Comments" name="comments">
                            <field name="comments" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_marathon_advertiser_search" model="ir.ui.view">
        <field name="name">marathon.advertiser.search</field>
        <field name="model">marathon.advertiser</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="account_id"/>
                <field name="advertiser_number"/>
                <filter string="Approved Duplicate" name="approved" domain="[('duplicate_approval','=','approved')]"/>
                <filter string="Hold Placed" name="hold" domain="[('hold_placed_on_advertiser_account','=',True)]"/>
                <filter string="CIA Required" name="cia" domain="[('advertiser_cia','=',True)]"/>
                <filter string="Approved to Book" name="approved_book" domain="[('advertiser_approved_to_book','=',True)]"/>
                <filter string="New Advertisers" name="new_adv" domain="[('new_advertiser','=',True)]"/>
                <separator/>
                <filter string="Account" name="g_account" context="{'group_by':'account_id'}"/>
                <filter string="Approval" name="g_approval" context="{'group_by':'duplicate_approval'}"/>
            </search>
        </field>
    </record>

    <record id="action_marathon_advertiser" model="ir.actions.act_window">
        <field name="name">Advertisers</field>
        <field name="res_model">marathon.advertiser</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_marathon_advertiser_search"/>
    </record>

</odoo>
