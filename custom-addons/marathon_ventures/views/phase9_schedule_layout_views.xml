<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- PHASE 9 - Schedule Creation form redesign (regrouped per Arianna). -->

  <record id="view_mv_schedules_form_phase9_layout" model="ir.ui.view">
    <field name="name">mv.schedules.form.phase9.layout</field>
    <field name="model">mv.schedules</field>
    <field name="inherit_id" ref="marathon_ventures.view_mv_schedules_form"/>
    <field name="priority">200</field>
    <field name="arch" type="xml">

      <xpath expr="//form" position="attributes">
        <attribute name="class">mv-deal-redesign</attribute>
        <!-- No New button on this form. A schedule is created from the Deal
             form's New Schedule button or the Additional Schedules wizard,
             both of which pass the Deal Parent; creating one from a blank
             form left it parentless. The Schedules list keeps its own New. -->
        <attribute name="create">false</attribute>
      </xpath>

      <!-- (A) Banner: Record Type radio only.
           The record name used to sit on the left, but the breadcrumb above
           already shows it, so the form opened with the same name twice.
           Record Type carries its own field label instead of a styled
           caption, which keeps its help text reachable. -->
      <xpath expr="//div[hasclass('oe_title')]" position="replace">
        <div class="mv-deal-banner d-flex align-items-center">
          <!-- Explicit <label>: a bare <field> outside a <group> renders no
               label at all, so the radios arrived unlabelled. The label also
               carries the field's help, which the old styled caption did
               not. -->
          <label for="sf_record_type" class="me-2"/>
          <field name="sf_record_type" widget="radio"
                 options="{'horizontal': true}" nolabel="1"/>
        </div>
      </xpath>


      <!-- (A2) Key Schedule Facts ribbon (top, all tabs) - read-only data
           from the schedule and its parent Deal, mirroring the Deal form's
           Key Deal Facts ribbon. -->
      <xpath expr="//notebook" position="before">
        <group name="key_schedule_facts_ribbon"
               class="mv-key-ribbon mv-key-ribbon-7"
               invisible="not id"
               col="7">
          <group col="1">
            <field name="kf_account" readonly="1" force_save="1"/>
          </group>
          <group col="1">
            <field name="kf_advertiser" readonly="1" force_save="1"/>
          </group>
          <group col="1">
            <field name="kf_brands" readonly="1" force_save="1"/>
          </group>
          <group col="1">
            <field name="kf_length" readonly="1" force_save="1"/>
          </group>
          <group col="1">
            <field name="kf_order_number" readonly="1" force_save="1"/>
          </group>
          <group col="1">
            <field name="currency_id" invisible="1"/>
            <field name="total_dollars" widget="monetary" readonly="1" force_save="1"/>
          </group>
          <group col="1">
            <field name="equiv_30" readonly="1" force_save="1"/>
          </group>
        </group>
      </xpath>

      <!-- (B) Replace Details page with the regrouped layout. -->
      <xpath expr="//notebook/page[1]" position="replace">
        <page string="Details" name="page_details">

          <group col="3" name="grp_sched_main" class="mv-essentials-grid mv-details-row">
            <group>
              <field name="program" readonly="1"/>
            </group>
            <group>
              <field name="deal_parent"/>
            </group>
            <group>
              <field name="status"/>
            </group>
          </group>

          <!-- mv-timing-row: the two time columns are narrower than an even
               fifth and Days Allowed takes what they give up - seven day tags
               wrapped onto three lines at an even split. -->
          <group col="5" name="grp_sched_timing"
                 class="mv-essentials-grid mv-essentials-grid-5 mv-timing-row mv-details-row">
            <group>
              <field name="week" string="Start Week" required="1"
                     options="{'numeric': true}"/>
            </group>
            <group>
              <field name="program_daypart" readonly="0"/>
            </group>
            <group>
              <field name="start_time"/>
            </group>
            <group>
              <field name="end_time"/>
            </group>
            <group>
              <field name="days_allowed" widget="many2many_tags"/>
            </group>
          </group>

          <group col="4" name="grp_sched_pricing"
                 class="mv-essentials-grid mv-essentials-grid-4 mv-details-row">
            <group>
              <field name="rate" readonly="0"/>
            </group>
            <group>
              <field name="units_available" readonly="0"/>
            </group>
            <group>
              <field name="cap"/>
            </group>
            <group>
              <field name="max_per_day"/>
            </group>
          </group>

          <!-- Footer: Cancel only (discard edits, same behavior as the
               Deal form via mv_deal_footer.js). Saving now lives beside the
               record name, so the Save Schedule button here was a second
               copy of it. Canceling the RECORD is different again and lives
               up there too (Cancel/Uncancel Schedule). -->
          <div class="mv-form-footer">
            <a href="#"
              role="button"
              class="btn btn-secondary mv_cancel_deal">
                Cancel
            </a>
          </div>

        </page>
      </xpath>
      <!-- (C) Additional Fields tab - every Schedule field that
           is not already in the Details tab, laid out in a 3-col
           mv-essentials-grid (label-on-top per column). -->
      <xpath expr="//notebook/page[1]" position="after">
        <!-- (C) Additional Fields tab.
             Was every Schedule field not already on Details - 224 of them,
             alphabetical, and all but a handful permanently blank because
             their computes are un-ported Salesforce formulas. Cut to the
             fields people actually work in, per Arianna's design: units and
             dollars first, then billing.

             Of the 201 fields dropped here, six held any data at all across
             8,793 schedules in dev, and Units Aired was the one that
             mattered - it is what Run Preemptions produces. It is kept, next
             to Units Preempted. The fields themselves are untouched on the
             model; this only stops the form rendering them. -->
        <page string="Additional Fields" name="page_additional_fields">

          <!-- Monetary fields need the currency in the view to render. The
               Key Schedule Facts ribbon declares it too, but stating it here
               means this tab does not silently lose its $ signs if that
               ribbon ever moves. -->
          <field name="currency_id" invisible="1"/>

          <group col="3" name="grp_addl_units" class="mv-essentials-grid mv-details-row">
            <group>
              <field name="dollars_booked" readonly="0"/>
              <!-- Capped Dollars is a Float on the model while every other
                   dollar field here is Monetary, so it rendered alone without
                   a currency symbol. The widget puts the $ back from the view;
                   retyping the field is the real fix and is a model change. -->
              <field name="capped_dollars" readonly="0" widget="monetary"
                     options="{'currency_field': 'currency_id'}"/>
              <field name="dollars_canceled" readonly="0"/>
              <field name="wo_booked" readonly="0"/>
            </group>
            <group>
              <field name="wo_30_units" readonly="0"/>
              <field name="x30_rate" readonly="0"/>
              <field name="capped_units" readonly="0"/>
              <field name="locked_units" readonly="0"/>
            </group>
            <group>
              <field name="units_preempted" readonly="0"/>
              <field name="units_aired" readonly="0"/>
              <field name="priority" readonly="0"/>
            </group>
          </group>

          <group col="3" name="grp_addl_billing" class="mv-essentials-grid mv-details-row">
            <group>
              <field name="intacct_si_number" readonly="0"/>
              <field name="intacct_cm_number" readonly="0"/>
              <field name="intacct_si_number_date_fully_paid" readonly="0"/>
              <field name="intacct_si_number_payment_status" readonly="0"/>
              <field name="net_total" readonly="0"/>
            </group>
            <group>
              <field name="netsuite_invoice_number" readonly="0"/>
              <field name="netsuite_invoice_url" readonly="0"/>
              <field name="performance" readonly="0"/>
              <field name="performance_dollars" readonly="0"/>
            </group>
            <group>
              <field name="additional_intacct_si_number" readonly="0"/>
              <field name="additional_intacct_si_number_comments" readonly="0"/>
              <field name="invoice_date" readonly="0"/>
            </group>
          </group>

        </page>
      </xpath>
    </field>
  </record>
</odoo>
