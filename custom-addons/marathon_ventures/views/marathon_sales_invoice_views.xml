<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_sales_invoice_tree" model="ir.ui.view">
        <field name="name">marathon.sales.invoice.tree</field>
        <field name="model">marathon.sales.invoice</field>
        <field name="arch" type="xml">
            <list string="Sales Invoices"
                  decoration-success="state == 'paid'"
                  decoration-danger="state == 'overdue'">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="advertiser_id"/>
                <field name="program_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="paid_amount" sum="Paid"/>
                <field name="balance_due" sum="Balance"/>
                <field name="state"/>
                <field name="currency_id" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_marathon_sales_invoice_form" model="ir.ui.view">
        <field name="name">marathon.sales.invoice.form</field>
        <field name="model">marathon.sales.invoice</field>
        <field name="arch" type="xml">
            <form string="Sales Invoice">
                <header>
                    <button name="action_issue" type="object" string="Issue"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_mark_paid" type="object"
                            string="Mark Paid"
                            invisible="state not in ('issued','partial','overdue')"
                            class="btn-success"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('paid','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="deal_id"/>
                            <field name="advertiser_id"/>
                            <field name="client_account_id"/>
                            <field name="program_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="invoice_month" readonly="1"/>
                            <field name="currency_id"/>
                            <field name="total_amount" readonly="1"/>
                            <field name="paid_amount" readonly="1"/>
                            <field name="balance_due" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids">
                                <list editable="bottom">
                                    <field name="line_number"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="schedule_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="line_total" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="payment_date"/>
                                    <field name="payment_method"/>
                                    <field name="check_id"/>
                                    <field name="amount" sum="Paid"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Totals">
                            <field name="total_id">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="currency_id" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes"><field name="notes" nolabel="1"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marathon_sales_invoice" model="ir.actions.act_window">
        <field name="name">Sales Invoices</field>
        <field name="res_model">marathon.sales.invoice</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
