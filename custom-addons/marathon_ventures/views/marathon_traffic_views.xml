<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_traffic_tree" model="ir.ui.view">
        <field name="name">marathon.traffic.tree</field>
        <field name="model">marathon.traffic</field>
        <field name="arch" type="xml">
            <list string="Traffic">
                <field name="name"/>
                <field name="deal_id"/>
                <field name="advertiser_id"/>
                <field name="brand_id"/>
                <field name="isci"/>
                <field name="length"/>
                <field name="received_date"/>
                <field name="delivery_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_marathon_traffic_form" model="ir.ui.view">
        <field name="name">marathon.traffic.form</field>
        <field name="model">marathon.traffic</field>
        <field name="arch" type="xml">
            <form string="Traffic">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="deal_id"/>
                            <field name="schedule_id"/>
                            <field name="advertiser_id" readonly="1"/>
                            <field name="brand_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="isci"/>
                            <field name="rotation"/>
                            <field name="creative_title"/>
                            <field name="length"/>
                            <field name="received_date"/>
                            <field name="delivery_date"/>
                            <field name="video_file_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Video Assets">
                            <field name="video_asset_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="video_file_id"/>
                                    <field name="is_primary"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_marathon_traffic" model="ir.actions.act_window">
        <field name="name">Traffic</field>
        <field name="res_model">marathon.traffic</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
