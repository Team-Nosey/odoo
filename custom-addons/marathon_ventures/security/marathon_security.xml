<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Groups: User and Manager.
         Note: Odoo 19 removed res.groups.category_id; group categorisation
         is now handled differently. We define plain groups here. -->
    <record id="group_marathon_user" model="res.groups">
        <field name="name">Marathon Ventures: User</field>
        <field name="comment">Day-to-day operations: create &amp; revise deals, schedules, traffic, etc.</field>
    </record>

    <record id="group_marathon_manager" model="res.groups">
        <field name="name">Marathon Ventures: Manager</field>
        <field name="implied_ids" eval="[(4, ref('group_marathon_user'))]"/>
        <field name="comment">Full administrative access including approval, deletion, and configuration.</field>
    </record>

    <!-- Make every internal user automatically a Marathon Ventures: User.
         This way the menu is visible without manual group assignment. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_marathon_user'))]"/>
    </record>

    <!-- Make admin (Settings group) a Marathon Ventures: Manager. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_marathon_manager'))]"/>
    </record>

    <!-- Record rules.
         Users can read/write/create deals; only Managers can delete. -->
    <record id="rule_marathon_deal_user" model="ir.rule">
        <field name="name">Deal: users can manage all (basic rule)</field>
        <field name="model_id" ref="model_marathon_deal"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_marathon_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_marathon_deal_manager" model="ir.rule">
        <field name="name">Deal: managers full access</field>
        <field name="model_id" ref="model_marathon_deal"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_marathon_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
